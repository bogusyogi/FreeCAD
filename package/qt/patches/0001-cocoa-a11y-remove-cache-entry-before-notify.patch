--- a/src/gui/accessible/qaccessiblecache_mac.mm
+++ b/src/gui/accessible/qaccessiblecache_mac.mm
@@ -36,9 +36,10 @@ void QAccessibleCache::removeAccessibleElement(QAccessible::Id axid)
